# Frontend static server
PORT=3000
HOST=127.0.0.1

# Backend API server
API_PORT=3001
API_HOST=127.0.0.1
NODE_ENV=development

# CORS and browser config
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://your-live-domain.com

# Database config
DATABASE_PATH=./database/morrow.sqlite
ADMIN_EMAIL=admin@morrow.local
ADMIN_PASSWORD=morrow-admin
ADMIN_NAME=Morrow Admin
# Optional: set this if you are using a custom SQLite installation
# SQLITE_PATH=C:/path/to/sqlite3.exe

# Next.js + Vercel config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.ref.supabase.co:5432/postgres

# Optional: browser override for API URL
# MORROW_API_URL=https://api.your-live-domain.com
